        // Render Product Grid
        function renderProducts() {
            const grid = document.getElementById("productGrid");
            const emptyState = document.getElementById("emptyState");
            const query = document.getElementById("searchInput").value.toLowerCase().trim();

            const filtered = products.filter(p => {
                const matchesCat = currentCategory === "all" || p.category === currentCategory;
                const matchesQuery = p.name.toLowerCase().includes(query) || 
                                     p.colorTag.toLowerCase().includes(query) ||
                                     p.dimensions.toLowerCase().includes(query);
                return matchesCat && matchesQuery;
            });

            if (filtered.length === 0) {
                grid.innerHTML = "";
                emptyState.classList.remove("hidden");
                return;
            }

            emptyState.classList.add("hidden");

            grid.innerHTML = filtered.map(product => {
                const inCartQty = cart[product.id] || 0;
                const defaultInputVal = inCartQty > 0 ? inCartQty : 1;

                return `
                <div class="bg-white rounded-2xl border ${inCartQty > 0 ? 'border-emerald-500 ring-2 ring-emerald-500/20' : 'border-slate-200/90'} shadow-sm hover:shadow-md transition-all flex flex-col overflow-hidden">
