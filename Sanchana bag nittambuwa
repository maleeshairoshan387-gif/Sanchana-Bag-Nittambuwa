                        </div>

                        <!-- Dimension Pill -->
                        <div class="absolute bottom-3 left-3 bg-slate-900/85 backdrop-blur-xs text-amber-300 text-xs font-bold px-2.5 py-1 rounded-lg border border-white/10">
                            📏 ${product.dimensions}
                        </div>

                        ${inCartQty > 0 ? `
                        <div class="absolute top-3 left-3 bg-emerald-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg shadow">
                            ✓ ${inCartQty} in Order
                        </div>` : ''}
                    </div>

                    <!-- Card Body -->
                    <div class="p-4 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                                ${product.category === 'backpack' ? 'Backpack' : 'Ladies Handbag'}
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900 mt-0.5 leading-snug">
                                ${product.name}
                            </h3>
                            <p class="text-xs text-slate-500 mt-1 line-clamp-2">
                                ${product.description}
                            </p>
                        </div>

                        <!-- Quantity Stepper & Add Button -->
                        <div class="mt-4 pt-3 border-t border-slate-100">
                            <div class="flex items-center justify-between gap-2">
                                <!-- Stepper -->
                                <div class="flex items-center border border-slate-300 rounded-xl bg-slate-50 overflow-hidden">
                                    <button type="button" onclick="adjustCardInput('${product.id}', -1)" class="w-9 h-9 flex items-center justify-center text-slate-700 hover:bg-slate-200 font-bold text-lg transition">−</button>
                                    <input 
                                        type="number" 
                                        id="qty-input-${product.id}" 
                                        value="${defaultInputVal}" 
                                        min="1" 
                                        max="999"
                                        class="w-11 h-9 text-center text-sm font-bold text-slate-900 bg-white border-x border-slate-200 focus:outline-none"
                                    >
                                    <button type="button" onclick="adjustCardInput('${product.id}', 1)" class="w-9 h-9 flex items-center justify-center text-slate-700 hover:bg-slate-200 font-bold text-lg transition">+</button>
                                </div>

                                <!-- Add / Update Button -->
                                <button 
                                    type="button" 
                                    onclick="addToCart('${product.id}')" 
                                    class="flex-1 h-9 px-3 rounded-xl font-bold text-xs sm:text-sm text-white ${inCartQty > 0 ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-slate-900 hover:bg-slate-800'} transition flex items-center justify-center gap-1.5 shadow-xs"
                                >
                                    <span>${inCartQty > 0 ? 'Update Qty' : '+ Add'}</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                `;
            }).join("");
        }

        // Category Filter
        function setCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll(".cat-btn").forEach(btn => {
                if (btn.dataset.cat === cat) {
                    btn.className = "cat-btn active px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap bg-slate-900 text-white shadow-sm transition";
                } else {
                    btn.className = "cat-btn px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap bg-slate-100 text-slate-700 hover:bg-slate-200 transition";
                }
            });
            renderProducts();
        }

        function filterProducts() {
            renderProducts();
        }

        function resetFilters() {
            document.getElementById("searchInput").value = "";
            setCategory("all");
        }

        // Adjust Card Quantity Input before adding
        function adjustCardInput(productId, delta) {
            const input = document.getElementById(`qty-input-${productId}`);
            let val = parseInt(input.value) || 1;
            val = Math.max(1, val + delta);
            input.value = val;
        }

        // Add or Update Item in Cart
        function addToCart(productId) {
            const input = document.getElementById(`qty-input-${productId}`);
            const qty = parseInt(input.value);
            
            if (!qty || qty <= 0) {
                showToast("කරුණාකර නිවැරදි ප්‍රමාණයක් ඇතුළත් කරන්න", "⚠️");
                return;
            }

            const product = products.find(p => p.id === productId);
            cart[productId] = qty;
            saveCart();
            updateTotalsUI();
            renderProducts();
            showToast(`${product.name} (${qty} pcs) ඇණවුමට එක් කළා`, "✅");
        }

        // Update Quantity directly inside Drawer
        function updateCartItemQty(productId, delta) {
            if (!cart[productId]) return;
            const newQty = cart[productId] + delta;
            if (newQty <= 0) {
                delete cart[productId];
            } else {
                cart[productId] = newQty;
            }
            saveCart();
            updateTotalsUI();
            renderCartDrawerItems();
            renderProducts();
        }

        function removeCartItem(productId) {
            delete cart[productId];
            saveCart();
            updateTotalsUI();
            renderCartDrawerItems();
            renderProducts();
        }

        function clearCart() {
            cart = {};
            saveCart();
            updateTotalsUI();
            renderCartDrawerItems();
            renderProducts();
            showToast("Order list එක හිස් කළා", "🗑️");
        }

        function saveCart() {
            try {
                localStorage.setItem("sanchana_bag_cart", JSON.stringify(cart));
            } catch (e) {}
        }

        // Calculate Totals & Update Badges
        function getCartSummary() {
            let totalPieces = 0;
            let totalAmount = 0;
            const items = [];

            for (const [id, qty] of Object.entries(cart)) {
                const product = products.find(p => p.id === id);
                if (product && qty > 0) {
                    const subtotal = product.price * qty;
                    totalPieces += qty;
                    totalAmount += subtotal;
                    items.push({ ...product, qty, subtotal });
                }
            }
            return { items, totalPieces, totalAmount };
        }

        function updateTotalsUI() {
            const { totalPieces, totalAmount } = getCartSummary();
            
            document.getElementById("headerCartBadge").textContent = totalPieces;
            document.getElementById("bottomTotalQty").textContent = `${totalPieces} pcs`;
            document.getElementById("bottomTotalPrice").textContent = `Rs. ${totalAmount.toLocaleString()}`;
            
            document.getElementById("drawerTotalQty").textContent = `${totalPieces} pcs`;
            document.getElementById("drawerTotalPrice").textContent = `Rs. ${totalAmount.toLocaleString()}`;

            const clearBtn = document.getElementById("clearCartBtn");
            if (totalPieces > 0) {
                clearBtn.classList.remove("hidden");
            } else {
                clearBtn.classList.add("hidden");
            }
        }

        // Render Items inside Slide-over Drawer
        function renderCartDrawerItems() {
            const container = document.getElementById("cartItemsContainer");
            const { items } = getCartSummary();

            if (items.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 px-4 bg-slate-50 rounded-2xl border border-dashed border-slate-300">
                        <p class="text-sm font-semibold text-slate-600">තවම කිසිදු බෑග් එකක් තෝරාගෙන නොමැත.</p>
                        <p class="text-xs text-slate-400 mt-1">ලැයිස්තුවෙන් ඔබට අවශ්‍ය බෑග් තෝරා "+ Add" ඔබන්න.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = items.map(item => `
                <div class="flex items-center justify-between gap-3 p-3 bg-white border border-slate-200 rounded-xl shadow-2xs">
                    <div class="min-w-0 flex-1">
                        <h5 class="text-sm font-bold text-slate-900 truncate">${item.name}</h5>
                        <div class="text-xs text-slate-500">
                            Rs. ${item.price.toLocaleString()} × ${item.qty} = <strong class="text-slate-800">Rs. ${item.subtotal.toLocaleString()}</strong>
                        </div>
                    </div>

                    <div class="flex items-center gap-1.5 shrink-0">
                        <button onclick="updateCartItemQty('${item.id}', -1)" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 font-bold text-slate-700">−</button>
                        <span class="w-7 text-center text-xs font-extrabold">${item.qty}</span>
                        <button onclick="updateCartItemQty('${item.id}', 1)" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 font-bold text-slate-700">+</button>
                        <button onclick="removeCartItem('${item.id}')" class="ml-1 p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg" title="Remove">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                        </button>
                    </div>
                </div>
            `).join("");
        }

        // Toggle Slide-over Cart Drawer
        function toggleCart(open) {
            const drawer = document.getElementById("cartDrawer");
            const backdrop = document.getElementById("cartBackdrop");
            const panel = document.getElementById("cartPanel");

            if (open) {
                renderCartDrawerItems();
                updateTotalsUI();
                drawer.classList.remove("hidden");
                // Trigger reflow for smooth CSS transition
                void drawer.offsetWidth;
                backdrop.classList.remove("opacity-0");
                panel.classList.remove("translate-x-full");
            } else {
                backdrop.classList.add("opacity-0");
                panel.classList.add("translate-x-full");
                setTimeout(() => {
                    drawer.classList.add("hidden");
                }, 300);
            }
        }

        // Format Wholesale Order Message
        function buildOrderMessage() {
            const { items, totalPieces, totalAmount } = getCartSummary();
            if (items.length === 0) {
                showToast("කරුණාකර පළමුව බෑග් තෝරන්න!", "⚠️");
                return null;
            }

            const shopName = document.getElementById("shopName").value.trim();
            const shopCity = document.getElementById("shopCity").value.trim();
            const shopPhone = document.getElementById("shopPhone").value.trim();
            const shopNote = document.getElementById("shopNote").value.trim();

            if (!shopName || !shopCity || !shopPhone) {
                showToast("කඩේ නම, නගරය සහ දුරකථන අංකය ඇතුළත් කරන්න!", "⚠️");
                return null;
            }

            let lines = [
                `*NEW WHOLESALE ORDER* 🎒`,
                `*To: Sanchana Bag - Nittambuwa*`,
                `--------------------------------`,
                `🏪 *Shop:* ${shopName}`,
                `📍 *City:* ${shopCity}`,
                `📞 *Phone:* ${shopPhone}`,
            ];

            if (shopNote) {
                lines.push(`📝 *Note:* ${shopNote}`);
            }

            lines.push(`--------------------------------`);
            lines.push(`*ORDER ITEMS:*`);

            items.forEach((item, index) => {
                lines.push(`${index + 1}. *${item.name}*`);
                lines.push(`   ${item.qty} pcs × Rs. ${item.price.toLocaleString()} = Rs. ${item.subtotal.toLocaleString()}`);
            });

            lines.push(`--------------------------------`);
            lines.push(`📦 *Total Bags:* ${totalPieces} pcs`);
            lines.push(`💰 *Total Amount:* Rs. ${totalAmount.toLocaleString()}`);
            lines.push(`--------------------------------`);
            lines.push(`_Sent via Sanchana Bag Order Portal_`);

            return lines.join("\n");
        }

        // Send Order directly to WhatsApp (076 363 7110)
        function sendWhatsAppOrder() {
            const message = buildOrderMessage();
            if (!message) return;

            const encodedText = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/${SHOP_WHATSAPP}?text=${encodedText}`;
            window.open(whatsappUrl, "_blank");
        }

        // Copy Order Summary to Clipboard
        function copyOrderSummary() {
            const message = buildOrderMessage();
            if (!message) return;

            const tempTextarea = document.createElement("textarea");
            tempTextarea.value = message;
            document.body.appendChild(tempTextarea);
            tempTextarea.select();
            document.execCommand("copy");
            document.body.removeChild(tempTextarea);

            showToast("Order විස්තරය Copy විය! දැන් WhatsApp හෝ SMS හරහා යවන්න.", "📋");
        }

        // Custom Toast Notification Helper
        let toastTimeout;
        function showToast(msg, icon = "✅") {
            const toast = document.getElementById("toast");
            document.getElementById("toastMessage").textContent = msg;
            document.getElementById("toastIcon").textContent = icon;

            toast.classList.remove("opacity-0", "-translate-y-2");
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add("opacity-0", "-translate-y-2");
            }, 3000);
        }

        // Initialize App on Load
        window.addEventListener("DOMContentLoaded", () => {
            renderProducts();
            updateTotalsUI();
        });
    </script>
</body>
</html>
